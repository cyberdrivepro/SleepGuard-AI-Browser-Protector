{
  "manifest_version": 3,
  "name": "SleepGuard AI - Browser Close Companion",
  "version": "1.0.0",
  "description": "Companion Chrome Extension for SleepGuard AI Web App. Enables automatic tab and browser closure upon AI sleep detection.",
  "permissions": [
    "tabs",
    "windows",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SleepGuard AI Status"
  }
}
